# Postgres (Neon). Filled automatically when you connect Neon on Vercel.
DATABASE_URL=
# Vercel Blob. Filled automatically when you connect a Blob store on Vercel.
BLOB_READ_WRITE_TOKEN=

# Admin sign-in. ADMIN_SECRET must be 32+ characters:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
ADMIN_SECRET=

# Razorpay (use rzp_test_ keys until you go live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in Razorpay Dashboard > Settings > Webhooks.
# URL: <SITE_URL>/api/razorpay-webhook, active event: payment.captured
RAZORPAY_WEBHOOK_SECRET=

# PayPal (optional, shows PayPal buttons for USD and EUR items). Create a REST app at developer.paypal.com.
# PAYPAL_ENV: sandbox (default) or live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Public site URL with no trailing slash, e.g. https://liquidshelf.com
SITE_URL=http://localhost:3000

# Optional defaults for the admin upload form
DEFAULT_PRICE=200
DEFAULT_CURRENCY=USD

# Optional email through Resend. Without RESEND_API_KEY no email is sent.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
